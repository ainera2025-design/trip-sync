# TripSync configuration
#
# These two values come from your Supabase dashboard:
#   Project settings -> API -> Project URL, and the "anon public" key.
#
# On Netlify: do NOT commit this file. Set the same two names in
# Site configuration -> Environment variables, and netlify.toml turns them
# into env.js at deploy time.
#
# Locally: copy this to .env, fill it in, then run
#   sh -c '. ./.env && printf "window.TRIPSYNC_ENV={url:\"%s\",anonKey:\"%s\"}" "$SUPABASE_URL" "$SUPABASE_ANON_KEY" > env.js'
# or just write env.js by hand (see README-style notes in index.html).

SUPABASE_URL=https://mwidbybnnsssohngnetf.supabase.co
SUPABASE_ANON_KEY=sb_publishable_jiUhv6EOtRQLJqPjNYJMww_DC08EN8Y

# The anon key is designed to be public: every browser app ships it to the
# client. It is safe to expose, and Row Level Security in database.sql is what
# actually protects your data. NEVER put the service_role key here or anywhere
# near the browser.
 